# Arcane merges this with project.env edits into .env; project.env wins.
# Keep secrets empty here — set them in Arcane Environment Configuration.
POSTGRES_PASSWORD=
RUNNER_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
BETTER_AUTH_SECRET=
ENCRYPTION_SECRET=
# Public origin for mirror (origin-only, no path). Secrets stay in Arcane UI.
BETTER_AUTH_URL=https://mirror.free-git.org
PUBLIC_BETTER_AUTH_URL=https://mirror.free-git.org
BETTER_AUTH_TRUSTED_ORIGINS=https://mirror.free-git.org,http://localhost:4321,http://localhost:8080
