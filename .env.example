# Copy to .env for local runs: cp .env.example .env
# Never commit .env (see .gitignore). Real values go in Arcane UI for remote.
POSTGRES_PASSWORD=change-me-postgres
RUNNER_TOKEN=change-me-runner-token
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
BETTER_AUTH_SECRET=change-me-32-char-min
ENCRYPTION_SECRET=change-me-32-char-min
# Public origin for mirror (behind Cloudflare Tunnel). Must be origin-only, no path.
BETTER_AUTH_URL=https://mirror.free-git.org
PUBLIC_BETTER_AUTH_URL=https://mirror.free-git.org
BETTER_AUTH_TRUSTED_ORIGINS=https://mirror.free-git.org,http://localhost:4321,http://localhost:8080
